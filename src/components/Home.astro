---
import { t, site, stack, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const other = lang === 'fr' ? '/en/' : '/';
const marquee = stack.flat();
const qr = '111101111100101001101111101000010100111011101010101011100100101111010101101001011101111101'.split('');
---
<header class="nav" style="view-transition-name: nav">
  <a href={lang === 'fr' ? '/' : '/en/'} class="brand" aria-label={site.name}>
    <span class="brand-mark"><img src="/img/imrane.webp" alt="" width="30" height="30" /></span>
    <span>Imrane Adli</span>
  </a>
  <nav class="nav-links" aria-label="Navigation">
    <a href="#work">{d.nav.work}</a>
    <a href="#about">{d.nav.about}</a>
    <a href="#experience">{d.nav.experience}</a>
    <a href="#stack">{d.nav.stack}</a>
  </nav>
  <div class="nav-actions">
    <a class="icon-btn" href={other} hreflang={lang === 'fr' ? 'en' : 'fr'} aria-label={d.toggles.lang}>{lang === 'fr' ? 'EN' : 'FR'}</a>
    <button class="icon-btn" id="theme" type="button" aria-label={d.toggles.theme}>
      <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <a class="btn btn-primary btn-sm magnetic" href="#contact">{d.nav.contact}</a>
  </div>
</header>

<main>
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="status" data-hero><span class="pulse" aria-hidden="true"></span>{d.hero.status}</span>
          <h1>
            {d.hero.title.map((w) => <span class="line"><span data-line>{w}</span></span>)}
          </h1>
          <p class="lede" data-hero>{d.hero.lede}</p>
          <div class="hero-cta" data-hero>
            <a class="btn btn-primary magnetic" href="#work">{d.hero.ctaPrimary} <span class="arrow" aria-hidden="true">↓</span></a>
            <a class="btn btn-ghost magnetic" href="#contact">{d.hero.ctaSecondary}</a>
          </div>
        </div>
        <div class="photo-wrap" data-photo>
          <div class="photo" id="photo">
            <img src="/img/imrane.webp" alt={d.hero.photoAlt} width="800" height="800" fetchpriority="high" />
            <div class="photo-meta"><span>Imrane Adli</span><span>{d.hero.location}</span></div>
          </div>
          <span class="chip chip-1" data-chip><img src="/icons/react.svg" alt="" />React</span>
          <span class="chip chip-2" data-chip><img src="/icons/nodejs.svg" alt="" />Node.js</span>
          <span class="chip chip-3" data-chip><img src="/icons/gcp.svg" alt="" />Google Cloud</span>
        </div>
      </div>
      <div class="stats">
        {d.stats.map((s) => (
          <div class="stat" data-reveal>
            <b><span data-count={s.value}>{s.value}</span>{s.suffix}</b>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...marquee, ...marquee].map(([i, l]) => (
        <span class="marquee-item"><img src={`/icons/${i}.svg`} alt="" loading="lazy" width="32" height="32" />{l}</span>
      ))}
    </div>
  </div>

  <section id="about">
    <div class="container">
      <span class="kicker" data-reveal>{d.about.kicker}</span>
      <p class="about-text">
        {d.about.text.split(' ').map((w) => <><span class="w">{w}</span>{' '}</>)}
      </p>
    </div>
  </section>

  <section id="work">
    <div class="container">
      <span class="kicker" data-reveal>{d.work.kicker}</span>
      <h2 class="h2" data-reveal>{d.work.title}</h2>
      <div class="projects">
        {d.projects.map((p, idx) => (
          <article class="project" style={`--i:${idx}`}>
            <div class="project-body">
              <span class="project-tag">{p.tag}</span>
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
              <div class="tags">{p.stack.map((s) => <span class="tag">{s}</span>)}</div>
              <div class="project-foot">
                {p.id === 'wrx' ? (
                  <>
                    <a href="https://wrx.link" target="_blank" rel="noopener">{d.work.live} ↗</a>
                    <a href="https://github.com/ADLI-Imrane/wrx-generator-v2" target="_blank" rel="noopener">{d.work.code} ↗</a>
                  </>
                ) : p.id === 'hris' ? (
                  <span>🔒 {d.work.company}</span>
                ) : (
                  <span>🔒 {d.work.private}</span>
                )}
              </div>
            </div>
            <div class="project-visual">
              {p.id === 'tunneleads' && (
                <img src="/img/tunneleads-demo.webp" alt="Tunneleads demo" loading="lazy" />
              )}
              {p.id === 'wrx' && (
                <div class="mock">
                  <div class="mock-glow" style="background: var(--accent)"></div>
                  <div class="mock-card">
                    <div class="qr" aria-hidden="true">{qr.map((b) => <i class={b === '1' ? '' : 'o'}></i>)}</div>
                    <div class="mock-row">🔗 wrx.link/<b>soutenance</b><small>QR ✓</small></div>
                    <div class="mock-row">📊 Analytics<small>Stripe</small></div>
                  </div>
                </div>
              )}
              {p.id === 'hris' && (
                <div class="mock">
                  <div class="mock-glow" style="background: var(--accent-2)"></div>
                  <div class="mock-card">
                    <b>RH · {lang === 'fr' ? 'Congés' : 'Leave'}</b>
                    <div class="mock-row">👤 {lang === 'fr' ? 'Demande de congé' : 'Leave request'}<small>{lang === 'fr' ? 'Validée' : 'Approved'}</small></div>
                    <div class="mock-row">💼 {lang === 'fr' ? 'Fiches employés' : 'Employee records'}<small>Azure</small></div>
                    <div class="mock-row">💳 {lang === 'fr' ? 'Paie du mois' : 'Monthly payroll'}<small>✓</small></div>
                  </div>
                </div>
              )}
              {p.id === 'workout' && (
                <div class="mock">
                  <div class="mock-glow" style="background: #7c5cff"></div>
                  <div class="phone">
                    <div class="ring"><b>72%</b></div>
                    <div class="mock-row" style="font-size:12px">🔥 {lang === 'fr' ? 'Quête du jour' : 'Daily quest'}</div>
                    <div class="bar"><i style="width:72%"></i></div>
                  </div>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="more">
        <h4 data-reveal>{d.more.title}</h4>
        {d.more.items.map((m) => (
          <div class="more-item" data-reveal>
            <b>{m.name}</b>
            <p>{m.desc}</p>
            <span>{m.stack}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="experience">
    <div class="container">
      <span class="kicker" data-reveal>{d.experience.kicker}</span>
      <h2 class="h2" data-reveal>{d.experience.title}</h2>
      <div class="exp-grid">
        <ol class="timeline">
          {d.experience.items.map((e) => (
            <li data-reveal>
              <time>{e.period}</time>
              <div><b>{e.role}</b> · <span class="org">{e.org}</span><p>{e.desc}</p></div>
            </li>
          ))}
        </ol>
        <div>
          <div class="side-card" data-reveal>
            <h4>{d.experience.education.title}</h4>
            <ul>{d.experience.education.items.map((e) => <li><b>{e.role}</b><span>{e.org} · {e.period}</span></li>)}</ul>
          </div>
          <div class="side-card" data-reveal>
            <h4>{d.experience.certs.title}</h4>
            <ul>{d.experience.certs.items.map((c) => <li class="cert"><i aria-hidden="true">OCI</i><span style="color:var(--text)">{c}</span></li>)}</ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="stack">
    <div class="container">
      <span class="kicker" data-reveal>{d.stack.kicker}</span>
      <h2 class="h2" data-reveal>{d.stack.title}</h2>
      <div class="bento">
        {stack.map((group, gi) => (
          <div class="bento-cell spot" data-reveal>
            <h4>{d.stackGroups[gi]}</h4>
            <div class="tech">
              {group.map(([i, l]) => <span><img src={`/icons/${i}.svg`} alt="" loading="lazy" width="26" height="26" />{l}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="container">
      <span class="kicker" data-reveal>{d.contact.kicker}</span>
      <h2 class="h2" data-reveal>{d.contact.title}</h2>
      <p data-reveal>{d.contact.text}</p>
      <div class="contact-actions" data-reveal>
        <a class="btn btn-primary magnetic" href={`mailto:${site.email}`}>{site.email}</a>
        <button class="btn btn-ghost magnetic" type="button" id="copy" data-email={site.email} data-done={d.contact.copied}>{d.contact.copy}</button>
      </div>
      <div class="socials" data-reveal>
        <a class="icon-btn" href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.3-.02-3-1.83-3-1.83 0-2.12 1.43-2.12 2.9V21H9z"/></svg>
        </a>
        <a class="icon-btn" href={site.github} target="_blank" rel="noopener" aria-label="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"/></svg>
        </a>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="container">
    <span>© 2026 Imrane Adli</span>
    <span>{d.footer}</span>
  </div>
</footer>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
