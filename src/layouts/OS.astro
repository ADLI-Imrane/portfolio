---
import '../styles/os.css';
import { t, type Lang } from '../i18n';
import { ui } from '../os/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const L = ui[lang];
const site = 'https://imrane-adli.pages.dev';
const path = lang === 'fr' ? '/' : '/en/';
const other = lang === 'fr' ? '/en/' : '/';
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{d.meta.title}</title>
    <meta name="description" content={d.meta.description} />
    <link rel="canonical" href={site + path} />
    <link rel="alternate" hreflang="fr" href={site + '/'} />
    <link rel="alternate" hreflang="en" href={site + '/en/'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={d.meta.title} />
    <meta property="og:description" content={d.meta.description} />
    <meta property="og:image" content={site + '/img/og.jpg'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <div class="boot" id="boot" aria-hidden="true">
      <div class="boot-in">
        <svg class="boot-logo" viewBox="0 0 64 64"><defs><linearGradient id="bl" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#5aa9ff"/><stop offset="1" stop-color="#a78bfa"/></linearGradient></defs><rect x="6" y="6" width="52" height="52" rx="14" fill="none" stroke="url(#bl)" stroke-width="4"/><text x="32" y="41" text-anchor="middle" font-family="Inter,Helvetica,Arial,sans-serif" font-weight="800" font-size="22" fill="#fff">IA</text></svg>
        <div class="boot-bar"><i></i></div>
        <small class="mono">{L.boot}</small>
      </div>
    </div>

    <header class="menubar">
      <div class="mb-left">
        <button class="mb-item mb-logo" id="brand-btn" aria-haspopup="true" aria-expanded="false">
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="1.5" width="13" height="13" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M5.2 11V5M8 11V5l3 6V5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
          Imrane
        </button>
        <span class="mb-item mb-app" id="mb-app">Finder</span>
        <button class="mb-item mb-hide" data-menu-open="finder">{L.apps.finder}</button>
        <button class="mb-item mb-hide" data-menu-open="notes">{L.apps.notes}</button>
        <button class="mb-item mb-hide" data-menu-open="skills">{L.apps.skills}</button>
        <button class="mb-item mb-hide" data-menu-open="mail">{L.apps.mail}</button>
      </div>
      <div class="mb-right">
        <a class="mb-item" href={other} hreflang={lang === 'fr' ? 'en' : 'fr'} aria-label={d.toggles.lang}>{lang === 'fr' ? 'EN' : 'FR'}</a>
        <button class="mb-item mb-sys" id="mb-theme" aria-label={d.toggles.theme}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <span class="mb-item mb-sys mb-hide" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 9a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16a5 5 0 0 1 6 0"/><circle cx="12" cy="19.5" r="1" fill="currentColor"/></svg></span>
        <span class="mb-item mb-sys mb-hide" aria-hidden="true"><svg viewBox="0 0 28 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="7" width="21" height="10" rx="3"/><rect x="4.5" y="9.5" width="14" height="5" rx="1.5" fill="currentColor" stroke="none"/><path d="M25 10.5v3" stroke-linecap="round"/></svg></span>
        <span class="mb-item" id="mb-clock"></span>
      </div>
    </header>
    <div class="dropdown" id="brand-menu" hidden></div>

    <main class="desktop" id="desktop">
      <div class="wall-sig" aria-hidden="true"><div class="clock" id="wall-clock"></div><div class="date" id="wall-date"></div></div>
      <div class="d-icons" id="d-icons"></div>
      <div class="home-grid" id="home-grid"></div>
      <noscript><p style="position:absolute;top:80px;left:24px;right:24px;color:#fff;font-size:16px">{L.noscript}</p></noscript>
    </main>

    <div class="dock-wrap"><nav class="dock" id="dock" aria-label="Dock"></nav></div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script src="../os/os.ts"></script>
  </body>
</html>
